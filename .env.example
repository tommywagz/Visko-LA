# ==============================================================================
# Visko-LA Synthetic Aerial World & Telemetry Platform — Environment Template
# ==============================================================================
# Copy this file to `.env` in the repository root:
#   cp .env.example .env
#
# Dual-Mode Behavior (`backend/app/config.py`):
# - Zero-Credential Simulator Mode: Set `ORBIS_MOCK_MODE=true` and
#   `GCP_MOCK_MODE=true` (or leave `REACTOR_API_KEY` / `GCP_PROJECT_ID` at their
#   placeholder values) to run 100% offline with the deterministic synthetic
#   flight simulator, local GCS filesystem mirror, and SQLite BigQuery mirror.
# - Live Cloud Mode: Provide a valid `rk_...` `REACTOR_API_KEY` and GCP project
#   credentials (`GOOGLE_APPLICATION_CREDENTIALS` or `gcloud` ADC) with
#   `ORBIS_MOCK_MODE=false` and `GCP_MOCK_MODE=false`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reactor Platform & Visko Orbis Stable
# ------------------------------------------------------------------------------
# Server-only secret from https://reactor.inc/dashboard (NEVER expose to browser
# or prefix with NEXT_PUBLIC_).
REACTOR_API_KEY=rk_your_reactor_api_key_here

# Reactor REST API base URL (token exchange at POST ${REACTOR_API_URL}/tokens)
REACTOR_API_URL=https://api.reactor.inc

# Canonical live world model slug (must include `reactor/` owner prefix)
ORBIS_MODEL_SLUG=reactor/visko-orbis-stable

# Optional custom override for AerialSystemPromptCompiler camera rig template.
# Leave blank to use the built-in UAV gimbal templates (`forward_downward_oblique`,
# `nadir_downward`, `forward_fpv`).
ORBIS_AERIAL_SYSTEM_PROMPT=

# Project-level Reactor documentation MCP endpoint for AI coding agents
REACTOR_MCP_URL=https://docs.reactor.inc/mcp

# Set `true` for deterministic offline simulator mode without live GPU usage;
# set `false` when `REACTOR_API_KEY` holds a real `rk_...` key.
ORBIS_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP), Cloud Storage (GCS) & BigQuery (BQ)
# ------------------------------------------------------------------------------
# Target Google Cloud project ID and default region
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Absolute path to a GCP Service Account JSON key (recommended for GCS V4 Signed
# URLs). Leave blank when authenticating via `gcloud auth application-default login`
# or when running with `GCP_MOCK_MODE=true`.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional override if your gcloud Application Default Credentials live outside
# `~/.config/gcloud` (read by `backend/app/config.py`).
# CLOUDSDK_CONFIG=/Users/your-user/.config/gcloud

# Google Cloud Storage bucket and canonical object prefixes:
#   Seeds:    gs://${GCS_BUCKET_NAME}/${GCS_SEED_PREFIX}/{project_id}/{seed_id}_{filename}
#   Datasets: gs://${GCS_BUCKET_NAME}/${GCS_DATASET_PREFIX}/{project_id}/{folder_path}/{video_id}.mp4
GCS_BUCKET_NAME=visko-orbis-aerial-datasets
GCS_SEED_PREFIX=seeds
GCS_DATASET_PREFIX=datasets

# Expiration window (in seconds, minimum 60) for GCS V4 Signed download URLs
GCS_SIGNED_URL_EXPIRY_SECONDS=3600

# Google BigQuery dataset and canonical table names (7-col folders, 27-col datasets)
BQ_DATASET_ID=visko_aerial_telemetry
BQ_DATASETS_TABLE_ID=aerial_datasets
BQ_FOLDERS_TABLE_ID=aerial_folders

# Set `true` to persist objects in `${LOCAL_STORAGE_DIR}/gcs/` and catalog rows
# in `${LOCAL_STORAGE_DIR}/bq_catalog.db` (embedded SQLite mirror).
GCP_MOCK_MODE=false

# Local directory used by LocalStorageAdapter, SQLiteCatalogAdapter, and preset cache
LOCAL_STORAGE_DIR=./backend/.local_storage

# ------------------------------------------------------------------------------
# 3. Backend, Frontend Networking & E2E Test Overrides
# ------------------------------------------------------------------------------
# FastAPI / Uvicorn bind address and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Next.js web application port
FRONTEND_PORT=3000

# Comma-separated browser origins allowed by FastAPI CORSMiddleware
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-visible API & WebSocket base URLs consumed by Next.js (`frontend/`)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Optional isolated storage directory override read by `tests/e2e/playwright.config.ts`
# VISKO_E2E_STORAGE_DIR=/tmp/visko-la-e2e-storage
